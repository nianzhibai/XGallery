# 图集根目录（必填）
ALBUMS_DIR=
# SQLite 数据库位置
DATABASE_PATH=./data/xgallery.db

# 每天定时同步更新图集（默认关闭）
ALBUMS_SYNC_ENABLED=false
# IANA 时区
ALBUMS_SYNC_TIMEZONE=Asia/Shanghai
# 24 小时制
ALBUMS_SYNC_TIME=02:00

# 原图和缩略图缓存时间（秒），默认 7 天
ORIGINAL_CACHE_TTL=604800
PREVIEW_CACHE_TTL=604800

# 只读 API 调用（默认关闭）
API_ENABLED=false
# 多个密钥用英文逗号分隔，例如：API_KEYS=key1,key2
API_KEYS=
