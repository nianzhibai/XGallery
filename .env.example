# 图集根目录（必填）
ALBUMS_DIR=
# 是否索引动图（GIF、动画 WebP、APNG 等）；禁用时设置为 false
INCLUDE_ANIMATED_IMAGES=true
DATABASE_PATH=./data/xgallery.db

# 启用自定义访问验证，并配置 Cloudflare WAF 后再公开部署
GALLERY_ACCESS_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 当前环境允许的精确主机名，多个以逗号分隔，不含协议或端口
TURNSTILE_HOSTNAMES=
# 至少 32 字节的随机密钥，修改后现有会话失效
GALLERY_SESSION_SECRET=
